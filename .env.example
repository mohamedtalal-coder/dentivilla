# -----------------------------------------------------------------------------
# Dentivilla Environment Configuration
# -----------------------------------------------------------------------------

# PostgreSQL Connection String
# Local Docker: postgresql://dentivilla:dentivilla@localhost:5432/dentivilla
# Cloud (Neon / Supabase / Railway): postgresql://user:password@host/database?sslmode=require
DATABASE_URL="postgresql://dentivilla:dentivilla@localhost:5432/dentivilla"

# NextAuth / Auth.js Secret
# Generate a strong key with: npx auth secret  OR  openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Canonical URL (Optional on Vercel as trustHost: true is enabled in auth.config.ts)
# Local: http://localhost:3000
# Production: https://your-project.vercel.app
AUTH_URL="http://localhost:3000"

# Initial Admin Credentials (used by prisma/seed.ts)
ADMIN_EMAIL="admin@dentivilla.local"
ADMIN_PASSWORD="change-me-admin"
ADMIN_NAME="د. محمد ياسر الجبالي"

# Public Site URL (for metadata, OpenGraph, and links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Application-Level Encryption for Patient Data (AES-256-GCM)
# 256-bit key (32 bytes). Format as either 64 hex characters or "keyId:64hexChars" (e.g. "k1:<64-hex>").
# Generate with: openssl rand -hex 32  OR  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER store in git, client bundles, or database. Configure in Vercel Environment Variables.
PATIENT_DATA_ENCRYPTION_KEY="replace-with-a-64-character-hex-string"

# Optional: Previous encryption keys for seamless key rotation
# Comma-separated list of "keyId:keyValue", e.g. "k0:1122...hex"
# PATIENT_DATA_ENCRYPTION_KEYS_PREVIOUS="k0:..."

# Keyed HMAC-SHA-256 Blind Index Key for Patient Phone Numbers
# Used to search patients by exact phone number and detect duplicates without decrypting or storing plaintext.
# Generate with: openssl rand -hex 32  OR  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PATIENT_DATA_BLIND_INDEX_KEY="replace-with-a-64-character-hex-string"
