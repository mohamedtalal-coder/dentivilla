generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Patient {
  id           String        @id @default(cuid())
  fullName     String
  phone        String
  whatsapp     String?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]

  @@unique([phone])
  @@index([fullName])
}

model Treatment {
  id              String        @id @default(cuid())
  slug            String        @unique
  nameAr          String
  summaryAr       String
  descriptionAr   String
  durationMinutes Int           @default(45)
  requiresTeeth   Boolean       @default(true)
  sortOrder       Int           @default(0)
  appointments    Appointment[]
}

model Appointment {
  id                String            @id @default(cuid())
  reference         String            @unique
  patientId         String
  patient           Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  treatmentId       String
  treatment         Treatment         @relation(fields: [treatmentId], references: [id], onDelete: Restrict)
  teeth             String[]          @default([])
  startsAt          DateTime
  endsAt            DateTime
  status            AppointmentStatus @default(PENDING)
  patientNotes      String?
  medicalConditions String[]          @default([])
  adminNotes        String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([startsAt, endsAt])
  @@index([status])
  @@index([patientId])
}

model WorkingHours {
  id        String  @id @default(cuid())
  weekday   Int     @unique
  enabled   Boolean @default(true)
  startTime String
  endTime   String
}

model BlockedPeriod {
  id        String   @id @default(cuid())
  startsAt  DateTime
  endsAt    DateTime
  reason    String
  createdAt DateTime @default(now())

  @@index([startsAt, endsAt])
}

model ExtraSlot {
  id        String   @id @default(cuid())
  startsAt  DateTime
  endsAt    DateTime
  note      String?
  createdAt DateTime @default(now())

  @@index([startsAt, endsAt])
}

model AvailabilitySettings {
  id                 String @id @default("default")
  /// spacing between offered start times (minutes); appointment length comes from the treatment
  slotMinutes        Int    @default(15)
  bufferMinutes      Int    @default(15)
  bookingLeadHours   Int    @default(4)
  bookingHorizonDays Int    @default(30)
}

/// Editable public clinic details (singleton row id = "default"); empty fields fall back to defaults in src/lib/site.ts
model SiteSettings {
  id        String   @id @default("default")
  phone     String?
  whatsapp  String?
  email     String?
  address   String?
  mapsUrl   String?
  instagram String?
  facebook  String?
  tiktok    String?
  youtube   String?
  x         String?
  snapchat  String?
  updatedAt DateTime @updatedAt
}

/// Uploaded images, stored compressed (WebP) in the database so they survive redeploys on any host
model Media {
  id        String            @id @default(cuid())
  mimeType  String
  width     Int
  height    Int
  sizeBytes Int
  data      Bytes
  createdAt DateTime          @default(now())
  beforeOf  BeforeAfterCase[] @relation("CaseBefore")
  afterOf   BeforeAfterCase[] @relation("CaseAfter")
}

model BeforeAfterCase {
  id            String   @id @default(cuid())
  titleAr       String
  descriptionAr String?
  treatmentSlug String?
  beforeMediaId String
  afterMediaId  String
  before        Media    @relation("CaseBefore", fields: [beforeMediaId], references: [id], onDelete: Restrict)
  after         Media    @relation("CaseAfter", fields: [afterMediaId], references: [id], onDelete: Restrict)
  consentOnFile Boolean  @default(false)
  published     Boolean  @default(false)
  featured      Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([published, sortOrder])
}

model Offer {
  id            String   @id @default(cuid())
  badge         String   @default("عرض خاص")
  titleAr       String
  descriptionAr String
  price         Int
  originalPrice Int?
  treatmentSlug String?
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active, sortOrder])
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
}
