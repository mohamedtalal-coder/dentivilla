# -----------------------------------------------------------------------------
# Dentivilla Environment Configuration
# -----------------------------------------------------------------------------

# PostgreSQL Connection String
# Local Docker: postgresql://dentivilla:dentivilla@localhost:5432/dentivilla
# Cloud (Neon / Supabase / Railway): postgresql://user:password@host/database?sslmode=require
DATABASE_URL="postgresql://dentivilla:dentivilla@localhost:5432/dentivilla"

# NextAuth / Auth.js Secret
# Generate a strong key with: npx auth secret  OR  openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Canonical URL (Optional on Vercel as trustHost: true is enabled in auth.config.ts)
# Local: http://localhost:3000
# Production: https://your-project.vercel.app
AUTH_URL="http://localhost:3000"

# Initial Admin Credentials (used by prisma/seed.ts)
ADMIN_EMAIL="admin@dentivilla.local"
ADMIN_PASSWORD="change-me-admin"
ADMIN_NAME="د. محمد ياسر الجبالي"

# Public Site URL (for metadata, OpenGraph, and links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
